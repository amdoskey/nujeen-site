---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isRtl, type Locale } from '../i18n/locales';
import { reader } from '../lib/reader';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  activeNav?: 'home' | 'about' | 'activities' | 'projects' | 'contact';
}

const { locale, title, description = '', activeNav } = Astro.props;
const dir = isRtl(locale) ? 'rtl' : 'ltr';
const siteSettings = await reader.singletons.siteSettings.read();
---

<!DOCTYPE html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header locale={locale} activeNav={activeNav} siteSettings={siteSettings} />
    <slot />
    <Footer locale={locale} siteSettings={siteSettings} />
  </body>
</html>
