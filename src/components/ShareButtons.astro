---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  /** Absolute, canonical URL of the page being shared. */
  url: string;
  /** Page title in the current locale. */
  title: string;
}

const { locale, url, title } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const shareLinks = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  x: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  whatsapp: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
};

const btnClass =
  'flex h-10 w-10 items-center justify-center rounded-sm border border-line text-[13px] font-semibold transition hover:bg-ink hover:text-bone';
---

<div class="flex items-center gap-2.5">
  <span class="me-1 text-[13px] text-grey">{t(locale, 'share')}</span>
  <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label={t(locale, 'share_facebook')} class={btnClass}>
    f
  </a>
  <a href={shareLinks.x} target="_blank" rel="noopener noreferrer" aria-label={t(locale, 'share_x')} class={btnClass}>
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M18.9 3H21.7l-6.8 7.8L22.9 21h-6.4l-5-6.5L5.6 21H2.8l7.3-8.3L2.3 3h6.5l4.5 6.1L18.9 3zm-1.1 16.2h1.2L7.9 4.7H6.6l11.2 14.5z" />
    </svg>
  </a>
  <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={t(locale, 'share_whatsapp')} class={btnClass}>
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M12 3a9 9 0 0 0-7.75 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" stroke-linejoin="round" />
      <path
        d="M8.7 8.9c.15-.35.3-.4.5-.4h.45c.15 0 .3.02.45.35.18.4.55 1.35.6 1.45.05.1.08.25 0 .4-.08.15-.13.25-.25.4-.13.13-.27.3-.38.4-.13.13-.25.25-.1.5.15.28.68 1.1 1.45 1.78 1 .9 1.83 1.15 2.13 1.28.3.13.47.1.65-.1.18-.18.73-.85.9-1.13.18-.28.35-.22.58-.13.23.1 1.45.68 1.7.8.25.13.42.18.48.3.08.13.08.75-.17 1.45-.25.7-1.38 1.3-1.98 1.38-.55.08-1.2.13-1.95-.13-.45-.13-1.05-.35-1.85-.68-3.28-1.4-5.4-4.75-5.57-4.98-.17-.25-1.35-1.85-1.35-3.5 0-1.68.85-2.5 1.15-2.85z"
        fill="currentColor"
        stroke="none"
      />
    </svg>
  </a>
  <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label={t(locale, 'share_linkedin')} class={btnClass}>
    in
  </a>
  <button
    type="button"
    data-copy-link
    data-url={url}
    data-label-copy={t(locale, 'share_copy_link')}
    data-label-copied={t(locale, 'share_copied')}
    aria-label={t(locale, 'share_copy_link')}
    class={btnClass}
  >
    <span data-copy-link-text aria-hidden="true">↗</span>
  </button>
</div>

<script>
  function initCopyLinkButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      btn.addEventListener('click', async () => {
        const url = btn.dataset.url;
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          return;
        }

        const textEl = btn.querySelector<HTMLElement>('[data-copy-link-text]');
        const copiedLabel = btn.dataset.labelCopied ?? 'Copied';
        const copyLabel = btn.dataset.labelCopy ?? '';

        if (textEl) textEl.textContent = '✓';
        btn.setAttribute('aria-label', copiedLabel);

        if (resetTimer) clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          if (textEl) textEl.textContent = '↗';
          btn.setAttribute('aria-label', copyLabel);
        }, 2000);
      });
    });
  }

  initCopyLinkButtons();
</script>
