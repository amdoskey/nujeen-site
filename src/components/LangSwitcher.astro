---
import { locales, localeLabels, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  /** Path within the current locale, e.g. "/activities/my-slug". Defaults to the current URL's remainder. */
  path?: string;
}

const { locale, path } = Astro.props;

// Derive the "rest of path" after the /<locale> prefix so switching
// language keeps the visitor on the equivalent page.
const currentPath = Astro.url.pathname;
const segments = currentPath.split('/').filter(Boolean);
const rest = path ?? (segments.length > 1 ? `/${segments.slice(1).join('/')}` : '/');
---

<div class="flex gap-0.5">
  {
    locales.map((l) => (
      <a
        href={`/${l}${rest === '/' ? '' : rest}`}
        class:list={[
          'rounded-sm px-[11px] py-1 transition',
          l === locale ? 'bg-ink text-bone' : 'hover:text-ink',
        ]}
        style={{ letterSpacing: '.04em' }}
      >
        {localeLabels[l]}
      </a>
    ))
  }
</div>
