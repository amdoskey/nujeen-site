# Copy this file to .env and fill in real values before deploying.

# Contact form (src/components/ContactForm.astro) — get a free access key at
# https://web3forms.com (no account/backend needed, just an email to verify).
# This key is meant to be public/client-visible by Web3Forms' own design
# (same idea as a reCAPTCHA site key) — do NOT put a secret API key here.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: overrides the canonical/OG site URL baked into the build.
SITE_URL=https://nujeen.org
